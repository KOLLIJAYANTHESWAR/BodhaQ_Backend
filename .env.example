# ============================================================
# BodhaQ Backend Environment Configuration
# ============================================================
#
# Copy this file to .env and replace the placeholder values.
#
# IMPORTANT:
# - Do NOT put Gemini or Tavily API keys in this file.
# - Users provide their own Gemini/Tavily keys through the
#   BodhaQ frontend.
# - The frontend stores those keys only in sessionStorage and
#   sends them to the backend per request.
# - Never commit the real .env file to Git.
# ============================================================


# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------

FRONTEND_URL=http://localhost:5173


# ------------------------------------------------------------
# Anonymous session signing
# ------------------------------------------------------------
#
# Generate a strong random secret for your local/deployed
# environment.
#
# Example generation:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Never commit the real value.
# ------------------------------------------------------------

BODHAQ_SESSION_SECRET=replace_with_a_long_random_secret